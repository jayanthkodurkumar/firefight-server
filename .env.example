DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname?sslmode=require

# Auth (required)
JWT_SECRET_KEY=change-me-to-a-long-random-string
# JWT_EXPIRE_MINUTES=1440
# PASSWORD_RESET_EXPIRE_HOURS=1
# AUTH_EXPOSE_RESET_TOKEN=true

# SQS telemetry stream (worker + simulator)
TELEMETRY_QUEUE_URL=https://sqs.us-east-2.amazonaws.com/123456789012/firefight-telemetry
AWS_REGION=us-east-2

# Optional worker tuning
# SQS_WAIT_TIME_SECONDS=20
# SQS_MAX_MESSAGES=10

# Frontend CORS (comma-separated)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ticket chat QA agent
# OPENAI_API_KEY=sk-...
# CHAT_MODEL=openai:gpt-4o-mini
